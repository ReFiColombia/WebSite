# Every variable here is optional unless marked REQUIRED.
# NEXT_PUBLIC_ values are embedded in the browser bundle, so never put a
# secret or a paid provider key in them.

# --- Donations ---
# Treasury address per network. Default: the ReFi Colombia Safe (lib/donations.ts)
# on Ethereum, Celo, Optimism and Arbitrum. Polygon has no default because the
# Safe is not deployed there; set it only after deploying the Safe on Polygon.
NEXT_PUBLIC_ETHEREUM_RECIPENT=
NEXT_PUBLIC_POLYGON_RECIPENT=
NEXT_PUBLIC_CELO_RECIPENT=
NEXT_PUBLIC_OPTIMISM_RECIPENT=
NEXT_PUBLIC_ARBITRUM_RECIPENT=

# --- Wallet ---
# Reown (WalletConnect) project id. Default: the ReFi Colombia project in
# lib/chains.ts. The domain must be allowed in that project.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- RPC endpoints (default: public RPCs, see lib/chains.ts) ---
NEXT_PUBLIC_RPC_CELO=
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_SEPOLIA=

# --- Lending subgraphs (default: ReFi Colombia Studio, see lib/subgraphs.ts) ---
NEXT_PUBLIC_SUBGRAPH_STUDIO_ID=
NEXT_PUBLIC_SUBGRAPH_URL_CELO=
NEXT_PUBLIC_SUBGRAPH_URL_CELO_COP=
NEXT_PUBLIC_SUBGRAPH_URL_OPTIMISM=
NEXT_PUBLIC_SUBGRAPH_URL_POLYGON=
NEXT_PUBLIC_SUBGRAPH_URL_ARBITRUM=

# --- Lending contracts (default: deployed addresses, see constants/index.ts) ---
# NEXT_PUBLIC_REFIMED_LEND_ADDRESS_CELO=
# NEXT_PUBLIC_REFIMED_LEND_ADDRESS_CELO_V2=
# NEXT_PUBLIC_REFIMED_LEND_ADDRESS_OPTIMISM=
# NEXT_PUBLIC_REFIMED_LEND_ADDRESS_POLYGON=
# NEXT_PUBLIC_REFIMED_LEND_ADDRESS_ARBITRUM=
